# Copy to .env.local for local dev; add the same keys in Vercel -> Settings -> Environment Variables.

# Public site origin (canonical URLs, email links)
NEXT_PUBLIC_SITE_URL=https://ic-etite-28final.vercel.app

# Cloudflare D1 "icetite" via the gateway Worker (workers/d1-gateway).
# URL is printed by `npx wrangler deploy`; secret must match `npx wrangler secret put GATEWAY_SECRET`.
D1_GATEWAY_URL=
D1_GATEWAY_SECRET=

# 32+ random chars; also encrypts the SMTP password stored in D1.
# node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=

# Comma-separated emails that become admins when they sign up / log in
ADMIN_EMAILS=

# Vercel Cron secret for /api/cron/email
CRON_SECRET=

# Optional SMTP overrides (otherwise set in /admin/email)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465
# SMTP_SECURE=true
# SMTP_USER=
# SMTP_PASS=
# EMAIL_DAILY_LIMIT=450

# VIT payment API (when provider = "vit" in /admin/settings)
# VIT_PAYMENT_API_URL=
# VIT_PAYMENT_MERCHANT_ID=
# VIT_PAYMENT_SECRET=

# First admin account, created by `npm run db:setup` (change the password after first login)
ADMIN_EMAIL=
ADMIN_PASSWORD=
